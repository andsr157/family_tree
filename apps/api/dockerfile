FROM node:22-alpine AS builder
WORKDIR /src
ENV NODE_ENV=development

RUN corepack enable && corepack prepare pnpm@9 --activate

# Build from monorepo context
COPY . .
RUN test -f /src/package.json && test -d /src/apps/api || (echo "ERROR: Docker build context must be repo root" && exit 1)
RUN pnpm install --frozen-lockfile --prod=false
RUN pnpm --filter api build
# Create production node_modules for api
RUN pnpm --filter api deploy --prod /out/api

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Minimal runtime artifacts only
COPY --from=builder /out/api/node_modules ./node_modules
COPY --from=builder /src/apps/api/dist ./dist

# Compatibility path if platform tries /src/apps/api/dist/src/main.js
RUN mkdir -p /src/apps && ln -s /app /src/apps/api

RUN test -f /app/dist/src/main.js || (echo "ERROR: /app/dist/src/main.js missing in final image" && ls -la /app/dist && exit 1)

CMD ["node", "/app/dist/src/main.js"]